# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.packages
build/
.vscode
# Local Claude Code state (settings.local.json, token-logs/) stays private;
# project skills, hooks, commands and settings are shared.
/.claude/*
!/.claude/skills/
!/.claude/hooks/
!/.claude/commands/
!/.claude/settings.json
!/.claude/statusline.sh
/.agents/.agents/
/ios/video_player/.swiftpm/xcode/
